{% extends 'partials/base.html.twig' %}
{% block content %}<div class="content-shell wrap"><a class="text-link back" href="{{ home_url }}">返回首页</a><p class="eyebrow">YIXINYUAN / {{ page.header.english_label|default('INSIDE YIXINYUAN')|e }}</p><h1>{{ page.title|e }}</h1><div class="prose lead">{{ page.content|raw }}</div>{% if focused_design and page.route == '/qualifications' %}{% include 'partials/certificate-gallery.html.twig' %}{% else %}<div class="content-grid">{% set count = 0 %}{% for item in page.children.published.routable.order('date','desc') %}{% if not item.header.demo and (not item.header.show_in_designs or design in item.header.show_in_designs) %}{% set count = count + 1 %}{% include 'partials/content-card.html.twig' with {'item': item} %}{% endif %}{% endfor %}{% if count == 0 %}<p class="empty">内容正在整理中，欢迎稍后关注。</p>{% endif %}</div>{% endif %}</div>{% endblock %}
