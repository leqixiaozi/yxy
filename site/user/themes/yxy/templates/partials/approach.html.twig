<section id="approach" class="approach section wrap" aria-labelledby="approach-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'approach'} %}{% endif %}<p class="eyebrow" data-reveal>02 <span>{{ focused_design ? 'HOW WE WORK' : 'OUR APPROACH' }}</span><small>{{ approach_label|e }}</small></p><div data-reveal><h2 id="approach-title">{{ (focused_design ? home.header.approach_heading|replace({'，':'','。':''}) : home.header.approach_heading)|e|nl2br }}</h2><ol class="approach-steps">{% set display_steps = focused_design and home.header.constellation_approach_steps ? home.header.constellation_approach_steps : home.header.approach_steps %}{% for step in display_steps %}<li><span>0{{ loop.index }}</span><strong>{{ step.title|e }}</strong><p>{{ step.description|e }}</p>{% if focused_design and step.output %}<b class="step-output">{{ step.output|e }}</b>{% endif %}</li>{% endfor %}</ol></div></section>
