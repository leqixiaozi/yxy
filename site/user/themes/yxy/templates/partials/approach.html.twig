<section id="approach" class="approach section wrap" aria-labelledby="approach-title"><p class="eyebrow" data-reveal>02 <span>{{ focused_design ? 'HOW WE WORK' : 'OUR APPROACH' }}</span><small>{{ approach_label|e }}</small></p><div data-reveal><h2 id="approach-title">{{ home.header.approach_heading|e|nl2br }}</h2><ol class="approach-steps">{% for step in home.header.approach_steps %}<li><span>0{{ loop.index }}</span><strong>{{ step.title|e }}</strong><p>{{ step.description|e }}</p></li>{% endfor %}</ol></div></section>
