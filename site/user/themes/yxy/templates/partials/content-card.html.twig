<a class="content-card" href="{{ item.url }}{{ design_query }}">{% set cover = item.media.images|first %}{% if cover %}<img class="card-image" src="{{ cover.url }}" alt="{{ item.title|e }}" loading="lazy">{% endif %}<span class="eyebrow">{{ item.header.content_label|default(item.parent.title)|e }}</span><h2>{{ item.title|e }}</h2><p>{{ item.header.summary|default(item.summary(100)|striptags)|e }}</p><span class="text-link">查看详情 <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></span></a>
