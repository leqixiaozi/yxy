<section id="about" class="about section" aria-labelledby="about-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'about'} %}{% endif %}<div class="wrap about-grid"><div data-reveal><p class="eyebrow"><span>ABOUT YIXINYUAN</span></p><h2 id="about-title">{{ (focused_design ? home.header.about_heading|replace({'，':'','。':''}) : home.header.about_heading)|e|nl2br }}</h2><p class="section-description">{{ (focused_design ? home.header.constellation_about_intro|default(home.header.about_intro) : home.header.about_intro)|e }}</p>{% if not focused_design %}<a class="text-link" href="{{ base_url_relative ~ '/qualifications' ~ design_query }}">关于我们与资质 <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}</div><div class="company-facts" data-reveal><div><span>成立于</span><strong>{{ home.header.founded|e }}</strong></div><div><span>立足</span><strong>深圳 · 宝安</strong></div><div><span>专注</span><strong>软件与技术服务</strong></div></div>{% if not focused_design %}<div class="qualification-links">{% for certificate in pages.find('/qualifications').children.published.routable.order('folder','asc') %}{% if not certificate.header.demo and (not certificate.header.show_in_designs or design in certificate.header.show_in_designs) %}<a href="{{ certificate.url }}{{ design_query }}"><span>{{ certificate.title|e }}</span><small>{{ certificate.header.issuer|e }}</small><img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}{% endfor %}</div>{% endif %}{% if focused_design %}<div id="contact" class="about-contact contact-content" data-reveal aria-labelledby="contact-title"><h3 id="contact-title">{{ (focused_design ? home.header.contact_heading|replace({'，':'','。':''}) : home.header.contact_heading)|e }}</h3><p>{{ home.header.contact_intro|e }}</p><div class="contact-details"><div><strong>{{ site.title|e }}</strong><p id="company-address">{{ home.header.address|e }}</p></div><div class="contact-actions">{% if home.header.email %}<a class="button primary" href="mailto:{{ home.header.email|e }}">邮件咨询 <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}{% if home.header.phone %}<a class="text-link" href="tel:{{ home.header.phone|e }}">{{ home.header.phone|e }}</a>{% endif %}{% if not home.header.phone and not home.header.email %}<p class="contact-note">{{ home.header.contact_note|e }}</p>{% endif %}<button class="button copy-address" type="button">复制办公地址 <img class="icon" src="{{ url('theme://icons/copy.svg') }}" alt=""></button><span class="copy-status" role="status"></span></div></div></div>{% endif %}</div></section>
