{% extends 'partials/base.html.twig' %}
{% block content %}
<section id="home" class="hero" aria-labelledby="hero-title"><div class="hero-art" aria-hidden="true"><img src="{{ url('theme://images/hero-' ~ design ~ '.webp') }}" alt="" width="1536" height="1024" fetchpriority="high"></div>
{% if design in ['constellation','nexus'] %}<canvas class="hero-canvas" aria-hidden="true" data-effect="{{ design }}"></canvas>{% endif %}
{% if design == 'studio' %}<div class="hero-spotlight" aria-hidden="true"></div>{% endif %}
<div class="hero-content wrap">
<p class="eyebrow hero-kicker">{{ design == 'flow' ? 'SOFTWARE, IN FLOW.' : (focused_design ? 'CONNECTED BY SOFTWARE' : 'SOFTWARE ENGINEERING STUDIO') }}</p>
{% if design == 'studio' %}<h1 id="hero-title" class="studio-title"><span>{{ home.header.studio_line1|e }}</span><span><em>{{ home.header.studio_emphasis|e }}</em> {{ home.header.studio_line2|e }}</span></h1><p class="studio-chinese">{{ home.header.studio_subtitle|e }}</p>
{% elseif focused_design %}<h1 id="hero-title">{{ home.header.constellation_line1|replace({'，':'','。':''})|e }}<br>{{ home.header.constellation_line2|replace({'，':'','。':''})|e }}<em><span>{{ home.header.constellation_emphasis|slice(0,1)|e }}</span><span>{{ home.header.constellation_emphasis|slice(1)|e }}</span></em></h1>
{% else %}<h1 id="hero-title">{{ home.header.flow_line1|e }}<br>{{ home.header.flow_line2|e }}<em><span>{{ home.header.flow_emphasis|slice(0,1)|e }}</span><span>{{ home.header.flow_emphasis|slice(1)|e }}</span></em></h1>{% endif %}
<p class="hero-intro">{{ (focused_design ? home.header.constellation_intro|default(home.header.intro) : home.header.intro)|e }}</p><div class="hero-actions"><a class="button primary" href="#contact">{{ home.header.cta_label|e }} <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a><a class="text-link" href="#services">了解服务 <img class="icon" src="{{ url('theme://icons/arrow-right.svg') }}" alt=""></a></div>
{% if design in ['constellation','nexus'] %}<p class="interaction-hint">{% if design == 'constellation' %}<span class="pointer-hint">移动探索星图 · 点击节点了解我们</span><span class="touch-hint">点击或轻触节点，了解服务与资质</span>{% else %}移动探索能量轨道 · 点击释放脉冲{% endif %}</p>{% elseif design == 'studio' %}<p class="interaction-hint">移动鼠标，感受光影与层次</p>{% endif %}
</div>
{% if design == 'nexus' %}<div class="hero-capabilities" aria-label="探索企业服务"><a data-feature="0" href="#services">软件开发 <span aria-hidden="true">↗</span></a><a data-feature="1" href="#services">技术咨询 <span aria-hidden="true">↗</span></a><a data-feature="2" href="#qualifications">企业资质 <span aria-hidden="true">↗</span></a></div>{% endif %}

{% if design == 'constellation' %}<div class="star-links" aria-label="探索企业服务"><a class="star-link" data-star="0" href="#services"><span>软件开发</span></a><a class="star-link" data-star="1" href="#services"><span>技术咨询</span></a><a class="star-link" data-star="2" href="#qualifications"><span>企业资质</span></a></div>{% endif %}
</section>
{% if design == 'studio' %}{% include 'partials/approach.html.twig' %}{% endif %}
<section id="services" class="services section wrap" aria-labelledby="services-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'services'} %}{% endif %}<div class="section-intro" data-reveal><p class="eyebrow">01 <span>{{ focused_design ? 'TECHNOLOGY SERVICES' : 'WHAT WE DO' }}</span></p><h2 id="services-title">{{ (focused_design ? home.header.constellation_services_heading|default(home.header.services_heading)|replace({'，':'','。':''}) : home.header.services_heading)|e|nl2br }}</h2><p class="section-description">{{ (focused_design ? home.header.constellation_services_intro|default(home.header.services_intro) : home.header.services_intro)|e }}</p></div><div class="service-list">{% set display_services = focused_design and home.header.constellation_services ? home.header.constellation_services : home.header.services %}{% for service in display_services %}{% if focused_design and service.scope is defined %}{% include 'partials/constellation-service.html.twig' %}{% elseif focused_design %}{% include 'partials/service-panel.html.twig' %}{% else %}<details class="service" data-service="{{ loop.index0 }}" data-reveal><summary><img class="service-icon" src="{{ url('theme://icons/' ~ (loop.first ? 'stack-2' : 'hexagons') ~ '.svg') }}" alt="" width="42" height="42"><span><strong>{{ service.title|e }}</strong><span class="service-summary">{{ service.summary|e }}</span></span><img class="expand-icon" src="{{ url('theme://icons/plus.svg') }}" alt="" width="24" height="24"></summary><div class="service-detail"><p>{{ service.description|e }}</p><a class="text-link" href="#contact">交流需求 <img class="icon" src="{{ url('theme://icons/arrow-right.svg') }}" alt=""></a></div></details>{% endif %}{% endfor %}</div></section>
{% if design != 'studio' %}{% include 'partials/approach.html.twig' %}{% endif %}
<section id="about" class="about section" aria-labelledby="about-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'about'} %}{% endif %}<div class="wrap about-grid"><div data-reveal><p class="eyebrow">03 <span>ABOUT YIXINYUAN</span></p><h2 id="about-title">{{ (focused_design ? home.header.about_heading|replace({'，':'','。':''}) : home.header.about_heading)|e|nl2br }}</h2><p class="section-description">{{ (focused_design ? home.header.constellation_about_intro|default(home.header.about_intro) : home.header.about_intro)|e }}</p>{% if not focused_design %}<a class="text-link" href="{{ base_url_relative ~ '/qualifications' ~ design_query }}">关于我们与资质 <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}</div><div class="company-facts" data-reveal><div><span>成立于</span><strong>{{ home.header.founded|e }}</strong></div><div><span>立足</span><strong>深圳 · 宝安</strong></div><div><span>专注</span><strong>软件与技术服务</strong></div></div>{% if not focused_design %}<div class="qualification-links">{% for certificate in pages.find('/qualifications').children.published.routable.order('folder','asc') %}{% if not certificate.header.demo and (not certificate.header.show_in_designs or design in certificate.header.show_in_designs) %}<a href="{{ certificate.url }}{{ design_query }}"><span>{{ certificate.title|e }}</span><small>{{ certificate.header.issuer|e }}</small><img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}{% endfor %}</div>{% endif %}</div></section>
{% if focused_design %}<section id="qualifications" class="qualifications section wrap" aria-labelledby="qualifications-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'qualifications'} %}{% endif %}<div class="section-intro"><p class="eyebrow">04 <span>QUALIFICATIONS</span></p><h2 id="qualifications-title">{{ '企业资质' }}<br>{{ '有据可查' }}</h2><a class="section-description text-link qualification-more" href="{{ base_url_relative }}/qualifications{{ design_query }}">查看更多 <img class="icon" src="{{ url('theme://icons/arrow-right.svg') }}" alt=""></a></div>{% include 'partials/certificate-gallery.html.twig' %}</section>{% endif %}
{% if official_products|length %}{% include 'partials/module-section.html.twig' with {'module_id':'products','module_title':'产品库','module_english':'SOFTWARE PRODUCTS','module_items':official_products} %}{% endif %}
{% if official_cases|length %}{% include 'partials/module-section.html.twig' with {'module_id':'cases','module_title':'客户案例','module_english':'SELECTED WORK','module_items':official_cases} %}{% endif %}
{% if official_news|length %}{% include 'partials/news-section.html.twig' %}{% endif %}
<section id="contact" class="contact section" aria-labelledby="contact-title">{% if focused_design %}{% include 'partials/section-backdrop.html.twig' with {'area':'contact'} %}{% endif %}<div class="contact-art" aria-hidden="true"><img src="{{ url('theme://images/hero-' ~ design ~ '.webp') }}" alt="" loading="lazy" width="1536" height="1024"></div><div class="wrap contact-content" data-reveal><p class="eyebrow">YIXINYUAN <span>LET’S TALK</span></p><h2 id="contact-title">{{ (focused_design ? home.header.contact_heading|replace({'，':'','。':''}) : home.header.contact_heading)|e }}</h2><p>{{ home.header.contact_intro|e }}</p><div class="contact-details"><div><strong>{{ site.title|e }}</strong><p id="company-address">{{ home.header.address|e }}</p></div><div class="contact-actions">{% if home.header.email %}<a class="button primary" href="mailto:{{ home.header.email|e }}">邮件咨询 <img class="icon" src="{{ url('theme://icons/arrow-up-right.svg') }}" alt=""></a>{% endif %}{% if home.header.phone %}<a class="text-link" href="tel:{{ home.header.phone|e }}">{{ home.header.phone|e }}</a>{% endif %}{% if not home.header.phone and not home.header.email %}<p class="contact-note">{{ home.header.contact_note|e }}</p>{% endif %}<button class="button copy-address" type="button">复制办公地址 <img class="icon" src="{{ url('theme://icons/copy.svg') }}" alt=""></button><span class="copy-status" role="status"></span></div></div></div></section>
{% endblock %}
